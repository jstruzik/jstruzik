---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const posts = (await getCollection("writing")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  });
---

<Layout
  title="Writing — Jacob Struzik"
  description="Notes by Jacob Struzik on engineering leadership and AI adoption."
>
  <h1>Writing</h1>
  {posts.length === 0 && <p>Nothing here yet.</p>}
  <ul>
    {
      posts.map((post) => (
        <li>
          <a href={`/writing/${post.id}/`}>{post.data.title}</a>
          <br />
          <time datetime={post.data.date.toISOString().slice(0, 10)}>
            {formatDate(post.data.date)}
          </time>
        </li>
      ))
    }
  </ul>
</Layout>
