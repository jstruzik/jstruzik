---
import Layout from "../layouts/Layout.astro";

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Jacob Struzik",
  jobTitle: "Engineering Leader",
  url: "https://jacobstruzik.com",
  email: "mailto:jacobstruzik@gmail.com",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Seattle",
    addressRegion: "WA",
    addressCountry: "US",
  },
  sameAs: [
    "https://github.com/jstruzik",
    "https://www.linkedin.com/in/jstruzik/",
  ],
});
---

<Layout>
  <script type="application/ld+json" set:html={jsonLd} slot="head" />
  <h1>Jacob Struzik</h1>
  <p>
    I am an engineering leader in Seattle. I work on developer platforms and
    AI-native engineering.
  </p>
  <p>
    I lead engineering at <a href="https://posit.co">Posit</a>, where I run the
    Package Manager team. Before that I founded Coldrays, a climate materials
    company, and was a director of engineering at Robin. Outside of work I
    spend my time rock climbing and playing competitive dodgeball. 🧗
  </p>
  <ul>
    <li><a href="https://github.com/jstruzik">GitHub</a></li>
    <li><a href="https://www.linkedin.com/in/jstruzik/">LinkedIn</a></li>
    <li><a href="/projects/">Projects</a></li>
  </ul>
  <p>
    Get in touch:
    <a href="mailto:jacobstruzik@gmail.com">jacobstruzik@gmail.com</a>
  </p>
</Layout>
