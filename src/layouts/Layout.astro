---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Jacob Struzik — Engineering Leader",
  description = "Jacob Struzik is an engineering leader in Seattle working on developer platforms and AI-native engineering.",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og-image.png", Astro.site);
const path = Astro.url.pathname;

const navItems = [
  { href: "/", label: "Home" },
  { href: "/projects/", label: "Projects" },
];

const isCurrent = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Jacob Struzik" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <slot name="head" />
  </head>
  <body>
    <div class="container">
      <nav class="site" aria-label="Site">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
      <main>
        <slot />
      </main>
      <footer class="site">
        <p>Jacob Struzik, Seattle</p>
      </footer>
    </div>
  </body>
</html>
